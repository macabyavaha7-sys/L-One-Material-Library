{
  "name": "l-one-material-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "scan": "node scripts/scan-assets.js",
    "dev": "npm run scan && vite --host 127.0.0.1",
    "rescan": "node scripts/scan-assets.js",
    "sync:r2": "node scripts/sync-r2-assets.js",
    "sync:hf": "node scripts/sync-hf-assets.js",
    "build": "npm run scan && tsc -b && vite build",
    "build:pages": "tsc -b && vite build && node scripts/copy-pages-data.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@huggingface/hub": "^2.12.0",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.4.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  }
}
